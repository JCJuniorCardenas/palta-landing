# Copiá este archivo como .env.local (en tu PC) y cargá las mismas variables en Railway.
# NUNCA subas .env.local a GitHub ni pegues estas claves en un chat.

# Base de datos. En Railway: creá un Postgres y copiá su DATABASE_URL.
# En tu PC dejalo vacío: usa una base embebida en la carpeta .data/
DATABASE_URL=
# Poné true solo si tu proveedor de Postgres exige SSL (Railway con URL pública)
DATABASE_SSL=false

# Panel de administración (/admin). Una sola persona: el dueño.
ADMIN_PASSWORD=
# Texto largo y aleatorio (mínimo 16 caracteres) para firmar la sesión
SESSION_SECRET=

# URL pública del sitio, sin barra final. Mercado Pago la usa para volver y avisar pagos.
SITE_URL=http://localhost:3000

# Mercado Pago (Tus integraciones > Credenciales). Sin esto, solo se ofrece transferencia.
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones > Webhooks). Recomendada.
MP_WEBHOOK_SECRET=
